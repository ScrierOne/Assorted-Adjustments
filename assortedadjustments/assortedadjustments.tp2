/////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Tweak PnP Celestial's script so they don't waste buffs on allies with spell protections" DESIGNATED 3041
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bg2ee eet" "Game must be Baldur's Gate 2:EE"
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~ca#dastr.bcs~ "Game must include PnP Celestials"

COPY_EXISTING
	~ca#dastr.bcs~ ~override~

DECOMPILE_AND_PATCH BEGIN
		REPLACE_TEXTUALLY 
	
	~!StateCheck(LastSeenBy(Myself),STATE_AID)~
	
	~!StateCheck(LastSeenBy(Myself),STATE_AID)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TRAP)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_DEFLECTION)
	!CheckStatGT(LastSeenBy(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)~
END

DECOMPILE_AND_PATCH BEGIN
		REPLACE_TEXTUALLY 
	
	~CheckStatLT(LastSeenBy(Myself),50,RESISTCOLD)~
	
	~CheckStatLT(LastSeenBy(Myself),50,RESISTCOLD)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TURNING)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_TRAP)
	!CheckStatGT(LastSeenBy(Myself),0,WIZARD_SPELL_DEFLECTION)
	!CheckStatGT(LastSeenBy(Myself),0,CLERIC_SHIELD_OF_THE_ARCHONS)~
END

BUT_ONLY IF_EXISTS

 
