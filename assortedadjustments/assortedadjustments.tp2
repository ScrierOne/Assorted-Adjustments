REQUIRE_PREDICATE GAME_IS "bg2ee eet " "Game must be EE "

COPY 
	"%MOD_FOLDER%/Spell/tensrapr.spl" override

COPY_EXISTING 
	"spwi603.spl" override 
			SAY UNIDENTIFIED_DESC @70
			LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode= 321 target= 1 parameter1 = 6  STR_VAR resource="tensrapr" END 
			LPF ADD_SPELL_EFFECT INT_VAR opcode= 146 target= 1 power = 6 parameter1 = 0 parameter2= 1  STR_VAR resource="tensrapr" END 
