/////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Illusion-Detecting Imoen (redistribute default Imoen's thieving skills)" DESIGNATED 5083
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bg2ee eet" "Game must be Baldur's Gate 2"

COPY_EXISTING 
	"imoen6.cre" override
	"imoen10.cre" override
	"imoen15.cre" override
	"imoen211.cre" override
	"imoen213.cre" override
	"imoen10.cre" override
	
WRITE_BYTE 0x45 0 // Hide in Shadows
WRITE_BYTE 0x64 90 // Detect Illusion
WRITE_BYTE 0x65 0 // Set Traps
WRITE_BYTE 0x67 30 // Open Locks
WRITE_BYTE 0x68 15 // Move Silently
WRITE_BYTE 0x69 55 // Find Traps
WRITE_BYTE 0x6A 0 // Pick Pockets									Total = 40 + 6*25 = 190
BUT_ONLY IF_EXISTS

