////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Time Stop makes affected creatures invulnerable" DESIGNATED 2130
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bgee bg2ee iwdee eet" "Game must be EE"

// Introduce spell that adds damage and effect immunities:

COPY
"%MOD_FOLDER%/Spell/tsimm.spl" override
"%MOD_FOLDER%/Spell/tsimm2.spl" override

COPY_EXISTING
                  "spwi909.spl"			override				// Wizard Time Stop
				  "rawi909.spl" 		override					// DoF Cleric Time Stop

LPF ADD_SPELL_EFFECT INT_VAR insert_point= 0 opcode = 146 timing = 0 target= 1 parameter1 = 0 parameter2 = 1 STR_VAR resource = "tsimm" END
IF_EXISTS BUT_ONLY

// Double length immunities for Wish version of Time Stop:

COPY_EXISTING
                  "spwish17.spl" 		override				// Wish Time Stop
				  "dw#wish3.spl" 		override				// SCS Wish Time Stop
LPF ADD_SPELL_EFFECT INT_VAR insert_point= 0 opcode = 146 timing = 0 target= 1 parameter1 = 0 parameter2 = 1 STR_VAR resource = "tsimm2" END
IF_EXISTS BUT_ONLY

// Time Stop immunizing abilities:

COPY_EXISTING
			"balth02.spl"		override				// Balthazar's Lunar Stance
			"kish7.spl"		override					// Monk Overhaul Lunar Stance
			"focus.spl"		override					// Ascension Focus ability
			
LPF CLONE_EFFECT INT_VAR match_opcode = 310 opcode = 206 STR_VAR resource = "tsimm" END
LPF CLONE_EFFECT INT_VAR match_opcode = 310 opcode = 206 STR_VAR resource = "tsimm2" END
IF_EXISTS BUT_ONLY

// Time Stop immune Creatures:

COPY_EXISTING
			"demogor2.cre" override 			// Demogorgon
			"CHALRV01.CRE" override 			// Ravager
			"OHBBRVGR.CRE" override 		// Black Pits Ravager
			"DRAGBLUE.CRE" override 		// Abazigal, Dragon Form
			"finmel01.cre" override 				// Final Battle Melissan
			
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = "tsimm" END
LPF ADD_CRE_EFFECT INT_VAR opcode = 206 target = 1 timing = 9 STR_VAR resource = "tsimm2" END
IF_EXISTS BUT_ONLY

/////////////////////////////////////////////////////////////////////////////////////////////////////
// PnP Strong Arm +2
/////////////////////////////////////////////////////////////////////////////////////////////////////

BEGIN "BG1-style (also adds enchantment bonus to damage)" DESIGNATED 2500 
SUBCOMPONENT "PnP Strong Arm +2"

COPY_EXISTING
			"BOW11.ITM" override
						LPF ALTER_ITEM_HEADER INT_VAR damage_bonus = 9 END
						READ_LONG 0x54 desc_strref
						GET_STRREF desc_strref desc
						INNER_PATCH_SAVE desc "%desc%" BEGIN
				REPLACE_TEXTUALLY ~Damage:\([^(missile)]*\)~ ~Damage: +9 ~ END						IF_EXISTS BUT_ONLY
						STRING_SET_EVALUATE desc_strref "%desc%"
	
BEGIN "BG2-style (doesn't add enchantment bonus to damage)" DESIGNATED 2501 
SUBCOMPONENT "PnP Strong Arm +2"
	
COPY_EXISTING
			"BOW11.ITM" override
						LPF ALTER_ITEM_HEADER INT_VAR damage_bonus = 7 END
						READ_LONG 0x54 desc_strref
						GET_STRREF desc_strref desc
						INNER_PATCH_SAVE desc "%desc%" BEGIN
				REPLACE_TEXTUALLY ~Damage:\([^(missile)]*\)~ ~Damage: +7 ~ END						IF_EXISTS BUT_ONLY
						STRING_SET_EVALUATE desc_strref "%desc%"

