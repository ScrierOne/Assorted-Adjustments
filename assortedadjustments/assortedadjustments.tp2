REQUIRE_PREDICATE GAME_IS "iwdee bgee bg2ee eet" "Game must be Baldur's Gate:EE"
REQUIRE_COMPONENT "DeitiesOfFaerun.tp2" 0 "This component requires Deities of Faerûn to be installed"

COPY_EXISTING
"RAWI321.spl" override// Spell Thrust
"RAWI805.spl" override// Pierce Shield
"RAWI419.spl" override// Secret Word
"RAWI608.spl" override// Pierce Magic

WRITE_LONG 0x018 0x01000600

IF_EXISTS BUT_ONLY

