/////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Dire Charm makes affected creatures berserk" DESIGNATED 2081
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bgee bg2ee eet" "Game must be Baldur's Gate 2"
/////////////////////////////////////////////////////////////////////////////////////////////////////

COPY_EXISTING 
~SPWI316.spl~ override
~SPPR982.SPL~ override // Trap
~SPWI943.spl~ override // Sirine
~SPIN171.spl~ override // Fiend

SAY UNIDENTIFIED_DESC @80
	LPF CLONE_EFFECT INT_VAR match_opcode = 5 opcode = 3 END
	LPF DELETE_EFFECT INT_VAR match_opcode = 5 END
	LPF CLONE_EFFECT INT_VAR match_opcode = 3 opcode = 5 parameter2 = 0 END
	LPF ALTER_EFFECT INT_VAR match_opcode = 3 parameter2 = 0 END
IF_EXISTS BUT_ONLY

/////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Prevent Mislead clones from being able to attack when speed weapons are equipped" DESIGNATED 2090
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bgee bg2ee eet" "Game must be Baldur's Gate:EE"

COPY_EXISTING
                  "mislead.spl"			override				// vanilla mislead
                  "g_misled.spl" 		override				// tnt Mislead
LPF DELETE_EFFECT INT_VAR match_opcode = 1 END
LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 1 END

LPF ADD_SPELL_EFFECT INT_VAR insert_point= 0 opcode = 1 timing = 1 target= 1 parameter1 = 0 parameter2 = 1 END
LPF ADD_SPELL_EFFECT INT_VAR insert_point= 1 opcode = 1 timing = 9 target= 1 parameter1 = "-4" parameter2 = 0 END
LPF ADD_SPELL_EFFECT INT_VAR insert_point= 2 opcode = 101 timing = 9 target= 1 parameter2 = 1 END
IF_EXISTS BUT_ONLY

/////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Allow Mislead clones to play Bard songs" DESIGNATED 2091
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bgee bg2ee eet" "Game must be Baldur's Gate:EE"

COPY_EXISTING
                  "mislead.spl"			override				// vanilla mislead
                  "g_misled.spl" 		override				// tnt Mislead
LPF DELETE_EFFECT INT_VAR match_opcode = 144 match_parameter2 = 10 END

////////////////////////////////////////////////////////////////////////////////////////////////////
BEGIN "Prevent Free Action from interfering with beneficial effects" DESIGNATED 2100
/////////////////////////////////////////////////////////////////////////////////////////////////////
REQUIRE_PREDICATE GAME_IS "bgee bg2ee eet" "Game must be Baldur's Gate:EE"

COPY_EXISTING 
	"RING09.ITM" override // Edventar's Gift
	"BDRING09.ITM" override // Edventar's Gift SoD
	"POTN45.ITM" override // Potion of Freedom
	"SPPR403.SPL" override // Cleric Free Action spell
	"SW2H06.ITM" override // Spider's Bane
	"BLUN30.ITM" override // Flail of Ages +5
	"SPER12.ITM" override // Ixil's Spike
	"NPPLAT.ITM" override // Keldorn's armor
		LPF DELETE_EFFECT INT_VAR match_opcode = 206 STR_VAR match_resource = "SPCL522" END  //Protection from spell: Defensive Spin
		LPF DELETE_EFFECT INT_VAR match_opcode = 206 STR_VAR match_resource = "SPIN572" END // Protection from spell: Haste
		LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 16 END // Immunity to Effect: Haste
		LPF DELETE_EFFECT INT_VAR match_opcode = 101 match_parameter2 = 126 END // Immunity to Effect: Movement rate bonus
		LPF DELETE_EFFECT INT_VAR match_opcode = 337 match_parameter2 = 16 END // Remove effect by opcode: Haste
		LPF DELETE_EFFECT INT_VAR match_opcode = 337 match_parameter2 = 126 END // Remove effect by opcode: movement rate bonus
		LPF DELETE_EFFECT INT_VAR match_opcode = 328 match_parameter2 = IDS_OF_SYMBOL (splstate HASTE_IMMUNITY) END // Spell State: Haste Immunity
		LPF DELETE_EFFECT INT_VAR match_opcode = 240 match_parameter2 = 38 END 	///remove portrait icon Haste 
		LPF DELETE_EFFECT INT_VAR match_opcode = 240 match_parameter2 = 195 END 	///remove portrait icon increased movement rate 
		LPF DELETE_EFFECT INT_VAR match_opcode = 169 match_parameter2 = 38 END 	///prevent  portrait icon Haste 
		LPF DELETE_EFFECT INT_VAR match_opcode = 169 match_parameter2 = 195 END 	///prevent  portrait icon increased movement rate 
		LPF DELETE_EFFECT INT_VAR match_opcode = 267 match_parameter2 = 16 END  //disable  display string hasted
IF_EXISTS BUT_ONLY

COPY_EXISTING 
	"RING09.ITM" override // Edventar's Gift
		SAY DESC @10
IF_EXISTS BUT_ONLY

COPY_EXISTING 
		"SCRL58.ITM" override // Cleric Free Action scroll
		SAY DESC @20
IF_EXISTS BUT_ONLY

COPY_EXISTING 
		"SPPR403.SPL" override // Cleric Free Action spell
		SAY UNIDENTIFIED_DESC @20
IF_EXISTS BUT_ONLY

COPY_EXISTING 
	"POTN45.ITM" override // Potion of Freedom
		SAY DESC @30
IF_EXISTS BUT_ONLY

COPY_EXISTING 
	"SW2H06.ITM" override // Spider's Bane
		SAY DESC @40 
IF_EXISTS BUT_ONLY

